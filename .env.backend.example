APP_ENV=production
APP_NAME=EchoMind API
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_PATH=/api/v1
APP_PUBLIC_BASE_URL=https://echomind.ulme.cn
APP_DEBUG=false

MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=replace_me

DEFAULT_USER_ID=demo-user-001
CORS_ORIGINS=*

AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=
AI_TEXT_MODEL=
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://router.huggingface.co/hf-inference/models/black-forest-labs/FLUX.1-schnell
AI_IMAGE_MODEL=FLUX.1-schnell
AI_TIMEOUT_SECONDS=60
GENERATED_MEDIA_DIR=storage/generated-images
